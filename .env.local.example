# Which TranscriptionService implementation to use.
# "mock"   — offline, deterministic, no API key required. Good for local dev and tests.
# "gemini" — calls the real Gemini API; requires GEMINI_API_KEY below.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini. Never exposed to the client —
# read exclusively by src/infrastructure/ai/providers/gemini.ts on the server.
GEMINI_API_KEY=

# Which RateLimiter implementation to use.
# "memory"  — single-instance, in-process. Fine for local dev; on serverless
#             deployments each cold instance gets its own empty counters, so
#             it does not actually limit anything across invocations.
# "upstash" — shared Redis (free tier at upstash.com); required once this
#             app runs on serverless, since it's the only backend that
#             holds the limit across every instance.
RATE_LIMIT_BACKEND=memory

# Required only when RATE_LIMIT_BACKEND=upstash. From your Upstash Redis
# database's REST API details. Never exposed to the client.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
