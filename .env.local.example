# Which TranscriptionService implementation to use.
# "mock"   — offline, deterministic, no API key required. Good for local dev and tests.
# "gemini" — calls the real Gemini API; requires GEMINI_API_KEY below.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini. Never exposed to the client —
# read exclusively by src/infrastructure/ai/providers/gemini.ts on the server.
GEMINI_API_KEY=
